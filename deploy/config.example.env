# Kronwerke Twitch bot. Read by systemd (EnvironmentFile), one KEY=value per line.

# The Twitch application from dev.twitch.tv/console (category Chat Bot). Its OAuth
# redirect URL must be exactly TTV_PUBLIC_URL + /auth/callback.
TTV_CLIENT_ID=
TTV_CLIENT_SECRET=

# Where the dashboard is reached from outside.
TTV_PUBLIC_URL=https://ttv.kronwerke.com

# The Twitch login that may sign in first. On that first sign-in the account is bound
# to its Twitch user id; renaming the account later changes nothing.
TTV_OWNER=elchi_dev

# Bearer token for the API without a browser (scripts, the team's tools). Empty turns
# that way in off; the dashboard works either way. openssl rand -hex 32
TTV_ADMIN_TOKEN=

# Optional
#TTV_HTTP_ADDR=127.0.0.1:13040
#TTV_STATE_DIR=/srv/projects/kronwerke-twitch/state
#TTV_UPDATE_REPO=kronwerke/twitch
