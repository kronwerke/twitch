[Unit]
Description=Kronwerke Twitch bot
Documentation=https://github.com/kronwerke/twitch
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=kronwerke-twitch
Group=kronwerke-twitch
EnvironmentFile=/etc/kronwerke-twitch/twitch.env
ExecStartPre=/usr/local/lib/kronwerke-twitch/rollback-guard.sh
ExecStart=/srv/projects/kronwerke-twitch/bin/kronwerke-twitch
# The service exits 0 to load a new release; always start it again.
Restart=always
RestartSec=5

# The service may only write its own folder (binary for self updates, state).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/projects/kronwerke-twitch
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
